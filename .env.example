# 이 파일을 복사해 .env를 만들고 값을 채워 주세요. (.env는 Git에 올리지 않습니다)

# Django
# SECRET_KEY 생성: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (쉼표로 구분, 프로토콜·포트 포함)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (로컬 개발 DB)
DB_NAME=shinchon_dev
DB_USER=shinchon
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# 세션·CSRF 쿠키 (운영 HTTPS에서는 True, CSRF_COOKIE_DOMAIN은 예: .godgoowm.com)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_DOMAIN=

# 카카오 로그인 (카카오 디벨로퍼스 > 내 애플리케이션)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 콘솔에서 Client Secret을 '사용 안 함'으로 바꾼 경우에만 False
KAKAO_CLIENT_SECRET_ENABLED=True
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback/

# 로그인 후 돌아갈 프론트엔드 주소 (끝에 / 없이)
FRONTEND_BASE_URL=http://localhost:3000

# Liner API - 프로모션 홍보 문구 초안 생성
LINER_API_KEY=